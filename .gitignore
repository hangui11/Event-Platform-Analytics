# ---- dependencies (regenerated by npm install) ----
node_modules/
ingestion/node_modules/

# ---- Python bytecode / caches ----
__pycache__/
*.pyc
.venv/
venv/

# ---- credentials & local env (never commit) ----
.env
*.env
application_default_credentials.json
*-key.json
*.pem

# ---- generated data (regenerable from generator.py, seed=42) ----
# 11 MB. Reviewers can recreate it with `python generator.py`.
# To ship it instead, delete or comment out the next line.
events.jsonl

# ---- only README.md ships as Markdown ----
# Every other .md is either a private working note (STEP1-7) or has a PDF
# version that ships instead (WRITEUP.pdf, AI_worklog.pdf, the api/ evidence).
# Ignore all Markdown, then un-ignore README.md.
*.md
!README.md

# ---- do not ship the api/ .sql and .txt working files ----
# The SQL is reproduced inside api/main.py; the validation numbers ship as
# api/VALIDATION_python_vs_bigquery.pdf.
api/*.sql
api/*.txt
# ...but requirements.txt is needed to install/deploy the API — keep it.
!api/requirements.txt

# ---- Codeway's confidential case brief (do not redistribute) ----
Jr Data Engineer Case Study.pdf

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
.vscode/
.idea/
